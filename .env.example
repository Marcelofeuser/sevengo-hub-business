DATABASE_URL=postgresql://user:pass@host:5432/railway
AUTH_INTERNAL_URL=http://auth.railway.internal:3000
TRUSTED_ORIGINS=http://localhost:5173
# Origin repassado pro auth service quando POST /perfis/convidar é chamado
# sem um header Origin de navegador (ex: script/Postman) — precisa estar
# cadastrado no TRUSTED_ORIGINS do serviço auth também. Chamadas de
# frontend de verdade já mandam Origin sozinhas, isso é só fallback.
AUTH_FALLBACK_ORIGIN=http://localhost:5173
PORT=3001

# Ponte de login pro Fin360 embutido no Hub (src/routes/fin360Bridge.ts).
# FIN360_SUPABASE_SERVICE_ROLE_KEY é secreta — pega em Settings > API do
# projeto Supabase "MotorDrive" e cola direto no Railway, nunca em texto.
FIN360_SUPABASE_URL=https://wkmirfymlujxuurefkpf.supabase.co
FIN360_SUPABASE_ANON_KEY=
FIN360_SUPABASE_SERVICE_ROLE_KEY=
FIN360_BRIDGE_EMAILS=marcelofeuser@icloud.com
